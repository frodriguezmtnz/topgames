# Copia este fichero a .env y rellena los valores. NUNCA subas .env a git
# (esta en .gitignore). Los valores de produccion viven en Vercel (Settings > Env Vars).

# --- Base de datos (Postgres / Neon) ---
# Host de Neon con endpoint "-pooler" (funciona con Prisma 7 en runtime y CLI).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c-1.eu-west-2.aws.neon.tech/neondb?sslmode=verify-full"

# --- LemonSqueezy (pagos) ---
# Dashboard de LS > Settings > API Keys / Stores. El producto debe ser
# "Pay what you want" con minimo 5 (el codigo manda custom_price en cada checkout).
LEMON_API_KEY=""
LEMON_STORE_ID=""
LEMON_VARIANT_ID=""
# Settings > Webhooks > Signing secret. El webhook apunta a:
# https://topvideogames.lol/api/webhooks/lemonsqueezy
LEMON_WEBHOOK_SECRET=""

# URL publica de la app (redirects del checkout, sitemap, OG y success token).
# En local: http://localhost:3000 · En produccion: https://topvideogames.lol
APP_URL="http://localhost:3000"

# 1 = pagos simulados sin tarjeta para probar en local.
# En produccion debe ser 0 (o no definido); en prod solo se permite checkout real.
PAYMENT_MOCK="0"

# --- Rate-limit (Upstash Redis) ---
# La integracion "Upstash" de Vercel inyecta estas variables en cada deployment.
# En local puedes copiarlas de Vercel (Settings > Env Vars) para usar Redis real,
# o dejarlas vacias: entonces el rate-limit usa un fallback en memoria (solo dev).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- Postgres local via Docker (opcional) ---
# docker compose up -d db
# DATABASE_URL="postgresql://topgames:topgames@localhost:5432/topgames"