# Produccion (Vercel): pega la URL de Neon y desactiva el mock.
# OJO: copia este fichero a .env y rellena los valores. NUNCA subas .env a git.

# --- Base de datos (Postgres / Neon) ---
# Host de Neon con endpoint "-pooler" (funciona con Prisma 7 en runtime y CLI).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c-1.eu-west-2.aws.neon.tech/neondb?sslmode=verify-full"

# --- LemonSqueezy (pagos) ---
LEMON_API_KEY=""            # Settings > API Keys
LEMON_STORE_ID="123456"     # TU store ID (Settings > Stores) - EJEMPLO inventado
LEMON_VARIANT_ID="123456"   # TU variant ID (Products > Variants) - EJEMPLO inventado
# Secreto del webhook (Settings > Webhooks > Signing secret)
LEMON_WEBHOOK_SECRET=""

# URL publica de la app (redirects del checkout).
APP_URL="http://localhost:3000"

# 1 = pagos simulados (sin tarjeta) para probar en local. En produccion pone 0.
PAYMENT_MOCK="1"

# --- Opcional: Postgres local via Docker ---
# docker compose up -d db
# DATABASE_URL="postgresql://topgames:topgames@localhost:5432/topgames"