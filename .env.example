# Copia este fichero a .env y rellena los valores. NUNCA subas .env a git
# (esta en .gitignore). Los valores de produccion viven en Vercel (Settings > Env Vars).

# --- Base de datos (Postgres / Neon) ---
# Host de Neon con endpoint "-pooler" (funciona con Prisma 7 en runtime y CLI).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.c-1.eu-west-2.aws.neon.tech/neondb?sslmode=verify-full"

# URL publica de la app (sitemap, OG, canonical, redirect de afiliados, emails).
# En local: http://localhost:3000 · En produccion: https://topvideogames.lol
APP_URL="http://localhost:3000"

# --- Catalogo de juegos (RAWG = GameProvider) ---
# https://rawg.io/apidocs -> Create account > Get API key. NO consultamos RAWG en
# cada page view; se cachea en la base local.
RAWG_API_KEY=""

# --- Auth / sesiones ---
# Sin secreto extra: los tokens de sesion/email/reset son aleatorios (randomBytes)
# y se guardan SOLO hasheados (sha256) en la BD.

# --- Rate-limit (Upstash Redis) ---
# La integracion "Upstash" de Vercel inyecta estas variables en cada deployment.
# En local puedes copiarlas de Vercel (Settings > Env Vars) para usar Redis real,
# o dejarlas vacias: entonces el rate-limit usa un fallback en memoria (solo dev).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- Afiliados (opcional) ---
# Tag que se anade a los enlaces de los proveedores con programa de comision
# (ver docs/affiliate-providers.md). Si se dejan vacios, el redirect de /out/ es
# directo pero NO se gana comision. Formato por proveedor: AFFILIATE_TAG_<UID>.
AFFILIATE_TAG_HUMBLE=""
AFFILIATE_TAG_AMAZON=""
# Generico (fallback si no esta el especifico de cada proveedor):
AFFILIATE_TAG=""

# --- Mail (envio de emails de verificacion / reset) ---
# Resend / Postmark / cualquier SMTP. Si esta vacio, en desarrollo los tokens
# se muestran por consola. (LOTE B si aun no se integra.)
RESEND_API_KEY=""
MAIL_FROM="TopVideoGames <noreply@topvideogames.lol>"

# --- Postgres local via Docker (opcional) ---
# docker compose up -d db
# DATABASE_URL="postgresql://topgames:topgames@localhost:5432/topgames"
