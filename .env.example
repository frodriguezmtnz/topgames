# Copia a .env y rellena los valores.
# Desarrollo local: apunta a una Postgres (Neon free o tu contenedor) o levanta docker-compose (ver abajo).
# Produccion (Vercel): pon la URL de Neon/Vercel Postgres y desactiva el mock.

# --- Base de datos (Postgres) ---
# Neon: crea una base gratis en neon.tech y pega la connection string (URL no pooler si usas Prisma).
DATABASE_URL="postgresql://user:password@host:5432/topgames?sslmode=require"

# --- LemonSqueezy (pagos) ---
# Obtenlos en tu dashboard de LemonSqueezy.
LEMON_API_KEY=""
LEMON_STORE_ID=""
LEMON_VARIANT_ID=""

# Secreto de los webhooks (Settings > Webhooks). Necesario en produccion.
LEMON_WEBHOOK_SECRET=""

# URL publica de la app (usada para los redirects del checkout).
# En local: http://localhost:3000 · En Vercel: https://tudominio.app
APP_URL="http://localhost:3000"

# 1 = activa pagos simulados (sin tarjeta) para probar en local.
# En produccion pon 0.
PAYMENT_MOCK="1"

# --- Opcional: Postgres local via Docker ---
# docker compose up -d db
# DATABASE_URL="postgresql://topgames:topgames@localhost:5432/topgames"