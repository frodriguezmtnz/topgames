# Copia a .env y rellena los valores.
# Local (SQLite): npm run db:migrate && npm run db:seed
# Produccion (Vercel): cambia a Postgres/Neon y usa el adapter pg (se vera en Fase 4).

DATABASE_URL="file:./dev.db"

# --- LemonSqueezy (pagos) ---
# Obtenlos en tu dashboard de LemonSqueezy.
LEMON_API_KEY=""
LEMON_STORE_ID=""
LEMON_VARIANT_ID=""

# Secreto de los webhooks (Settings > Webhooks). Necesario en produccion.
LEMON_WEBHOOK_SECRET=""

# URL publica de la app (usada para los redirects del checkout).
APP_URL="http://localhost:3000"

# 1 = activa pagos simulados (sin carta y sin LemonSqueezy) para probar en local.
PAYMENT_MOCK="1"